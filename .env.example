# Vercel > Settings > Environment Variables 에 같은 이름으로 등록합니다.

# 관리자 페이지(/admin) 비밀번호. 필수.
ADMIN_PASSWORD=

# 예약 화면에 표시되는 입금 계좌. 저장소에는 올리지 않습니다.
BANK_NAME=
BANK_NUMBER=
BANK_HOLDER=

# 변경/취소 문의 전화번호(선택). 비워두면 화면에 표시하지 않습니다.
CONTACT_PHONE=

# Upstash Redis. Vercel Marketplace에서 Upstash를 연결하면 아래 이름으로 자동 등록됩니다.
# (KV_REST_API_URL, KV_REST_API_TOKEN 이름도 인식합니다.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
